public class ReverseAlphabetical {
    public static void main(String[] args) {

        char[] ch = {'M', 'O', 'S', 'Q', 'U', 'E'};

        for (int i = 0; i < ch.length - 1; i++) {

            for (int j = i + 1; j < ch.length; j++) {

                if (ch[i] < ch[j]) {
                    char temp = ch[i];
                    ch[i] = ch[j];
                    ch[j] = temp;
                }
            }
        }

        System.out.print("Alphabetical Order: ");

        for (char c : ch)
            System.out.print(c + " ");
    }
}
